#!/usr/bin/env bash
# Adapter for github.com/numtide/nix-conformance's `./run` protocol (see
# that repo's README.md, "Writing an adapter"): invoked as
# `ADAPTER OP FILE [FLAG...]` from the conformance repo's own root. Must
# exit 3 for anything this implementation does not support, so the
# runner counts the case as skipped rather than failed -- never guess at
# unimplemented behavior.
set -u
op=${1:-}
file=${2:-}
shift 2 2> /dev/null || true

root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
bin="${ASNIX_BIN:-$root/asnix}"

case "$op" in
  eval)
    # The FLAGs are nix-instantiate's own, from a case's .flags sidecar.
    # Each one is either
    #   - translated to asnix's CLI: --arg/--argstr/-A (see main.c), and -I,
    #     which is a NIX_PATH entry in front of the others (compiler.c's
    #     resolve_search_path reads $NIX_PATH);
    #   - accepted because it changes nothing asnix prints: --eval/--strict
    #     are what this op is, --no-show-trace only changes the error text;
    #   - a feature this build implements (--extra-experimental-features);
    #   - or unsupported, and the case is skipped (exit 3), never guessed
    #     at: --impure, --lint-*, --max-call-depth, any other feature.
    args=()
    nix_path=${NIX_PATH:-}
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --eval | --strict | --no-show-trace) shift ;;
        --arg | --argstr)
          [ "$#" -ge 3 ] || exit 3
          args+=("$1" "$2" "$3")
          shift 3
          ;;
        -A)
          [ "$#" -ge 2 ] || exit 3
          args+=(-A "$2")
          shift 2
          ;;
        -I)
          [ "$#" -ge 2 ] || exit 3
          nix_path="$2${nix_path:+:$nix_path}"
          shift 2
          ;;
        --extra-experimental-features)
          [ "$#" -ge 2 ] || exit 3
          for feature in $2; do
            case "$feature" in
              parse-toml-timestamps) ;;
              *) exit 3 ;;
            esac
          done
          shift 2
          ;;
        *) exit 3 ;;
      esac
    done
    [ -z "$nix_path" ] || export NIX_PATH="$nix_path"
    exec "$bin" ${args[@]+"${args[@]}"} "$file"
    ;;
  *)
    # parse/check/nar/drv/flake/eval-xml/wire: not implemented.
    exit 3
    ;;
esac
