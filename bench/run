#!/usr/bin/env bash
# M9 benchmark harness: asnix vs real Nix (`nix-instantiate`) on the tiny
# micro-workloads in bench/workloads/*.nix (regenerated by
# bench/gen_workloads.sh -- see that script's comments for exactly what each
# workload measures and two real evaluator limitations found while sizing
# them). This is NOT a nixpkgs-scale or "field" comparison -- see
# bench/README.md for what's actually being measured and why, before
# reading too much into the numbers.
#
# Usage: bench/run [--iters N]
#   --iters N   shell-timing-loop fallback repeat count (default 20),
#               ignored when hyperfine is on PATH.
set -euo pipefail
cd "$(dirname "$0")/.."

ITERS=20
if [ "${1:-}" = "--iters" ]; then ITERS="$2"; fi

echo "== building asnix (release) =="
make release >/tmp/asnix_bench_build.log 2>&1 || { echo "build failed, see /tmp/asnix_bench_build.log" >&2; exit 1; }

if [ ! -x ./asnix ]; then
    echo "./asnix missing after build" >&2
    exit 1
fi

if ! command -v nix-instantiate >/dev/null; then
    echo "nix-instantiate not on PATH -- enter the flake devShell or install Nix" >&2
    exit 1
fi

OUTDIR="bench/results"
mkdir -p "$OUTDIR"
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
RESULTS_MD="$OUTDIR/${STAMP}.md"
RESULTS_JSON_DIR="$OUTDIR/${STAMP}.hyperfine"

# ---- provenance (see bench/README.md's "Methodology" for why each of
# these fields matters -- modeled loosely on ~/gnix/fix's provenance stamp,
# simplified since this isn't Zig/that project's tooling) ----
GIT_COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
GIT_DIRTY=$(git diff --quiet 2>/dev/null && echo clean || echo dirty)
UNAME=$(uname -a)
NPROC_N=$(nproc 2>/dev/null || echo unknown)
NIX_VERSION=$(nix-instantiate --version | head -1)
NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)

{
    echo "# asnix bench run"
    echo
    echo "- Timestamp (UTC): $NOW"
    echo "- Git commit: $GIT_COMMIT ($GIT_DIRTY)"
    echo "- uname -a: $UNAME"
    echo "- nproc: $NPROC_N"
    echo "- nix-instantiate: $NIX_VERSION"
    echo "- CFLAGS (release): see Makefile's \`release: OPT := -O2\`"
    echo
} > "$RESULTS_MD"

WORKLOADS=(bench/workloads/*.nix)

if command -v hyperfine >/dev/null; then
    echo "== using hyperfine =="
    mkdir -p "$RESULTS_JSON_DIR"
    echo "## Results (hyperfine, mean +/- stddev)" >> "$RESULTS_MD"
    echo >> "$RESULTS_MD"
    echo "| workload | asnix | nix-instantiate |" >> "$RESULTS_MD"
    echo "|---|---|---|" >> "$RESULTS_MD"
    for f in "${WORKLOADS[@]}"; do
        name=$(basename "$f" .nix)
        json="$RESULTS_JSON_DIR/${name}.json"
        hyperfine --shell=none --warmup 5 --min-runs 30 \
            --export-json "$json" \
            -n "asnix" "./asnix $f" \
            -n "nix-instantiate" "nix-instantiate --eval $f" \
            > "$RESULTS_JSON_DIR/${name}.txt" 2>&1 || {
                echo "hyperfine failed for $name, see $RESULTS_JSON_DIR/${name}.txt" >&2
                continue
            }
        cat "$RESULTS_JSON_DIR/${name}.txt"
        # Pull mean times (seconds) out of the JSON hyperfine just wrote,
        # without a JSON parser dependency -- the two results are always
        # the 1st and 2nd entries in that fixed order (asnix, nix-instantiate).
        asnix_mean=$(grep -m1 '"mean"' "$json" | grep -o '[0-9.]\+')
        nix_mean=$(grep -m2 '"mean"' "$json" | tail -1 | grep -o '[0-9.]\+')
        printf '| %s | %.6fs | %.6fs |\n' "$name" "$asnix_mean" "$nix_mean" >> "$RESULTS_MD"
    done
else
    echo "== hyperfine not found, falling back to shell timing loop (ITERS=$ITERS) =="
    echo "## Results (shell timing loop, $ITERS iterations, mean wall time)" >> "$RESULTS_MD"
    echo >> "$RESULTS_MD"
    echo "| workload | asnix | nix-instantiate |" >> "$RESULTS_MD"
    echo "|---|---|---|" >> "$RESULTS_MD"
    time_loop() {
        # Runs "$@" ITERS times, prints total seconds (float) to stdout.
        local start end
        start=$(date +%s.%N)
        for ((i = 0; i < ITERS; i++)); do "$@" >/dev/null 2>&1; done
        end=$(date +%s.%N)
        awk -v s="$start" -v e="$end" -v n="$ITERS" 'BEGIN { printf "%.6f", (e - s) / n }'
    }
    for f in "${WORKLOADS[@]}"; do
        name=$(basename "$f" .nix)
        asnix_t=$(time_loop ./asnix "$f")
        nix_t=$(time_loop nix-instantiate --eval "$f")
        echo "$name: asnix=${asnix_t}s nix-instantiate=${nix_t}s"
        printf '| %s | %ss | %ss |\n' "$name" "$asnix_t" "$nix_t" >> "$RESULTS_MD"
    done
fi

echo
echo "== wrote $RESULTS_MD =="
cat "$RESULTS_MD"
